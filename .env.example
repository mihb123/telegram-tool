# Cấu hình tele. Copy thành .env rồi sửa:  make env   (hoặc: cp .env.example .env)
#
# tele đọc .env theo thứ tự ưu tiên (biến đã export trong shell luôn thắng):
#   1. file chỉ định bởi $TELE_ENV_FILE
#   2. .env ở thư mục source này (khi chạy bin/tele, bin/tele-local)
#   3. ~/.config/tele/.env (dùng cho server chỉ cài binary ~/bin/tele)

# ---------------------------------------------------------------------------
# Database dùng chung — khai báo trên MỌI server chạy tele / tele-local
# ---------------------------------------------------------------------------
# Để trống = dùng SQLite local (~/.local/share/tele/messages.db), không chia sẻ.
# Máy chạy `make up`:  postgresql://tele:<mật khẩu>@localhost:5432/tele
# Server khác:        postgresql://tele:<mật khẩu>@<IP hoặc hostname máy chạy DB>:5432/tele
# Mật khẩu có ký tự đặc biệt (@ : / ? #) phải URL-encode; nên dùng mật khẩu chữ + số.
TELE_DATABASE_URL=postgresql://tele:change-me@localhost:5432/tele

# ---------------------------------------------------------------------------
# PostgreSQL server — chỉ cần trên máy chạy `make up`
# ---------------------------------------------------------------------------
POSTGRES_USER=tele
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tele
# Interface mở port: 0.0.0.0 cho server khác kết nối, 127.0.0.1 = chỉ máy này.
# Khi mở 0.0.0.0 hãy giới hạn bằng firewall/VPN, đừng để lộ ra internet.
TELE_DB_BIND=0.0.0.0
TELE_DB_PORT=5432

# ---------------------------------------------------------------------------
# Tuỳ chọn (bỏ dấu # để dùng)
# ---------------------------------------------------------------------------
# Số giây `tele get` được trả thẳng từ DB mà không hỏi Telegram (mặc định 300).
# TELE_CACHE_MAX_AGE=300
# Thư mục gốc lưu media tải về (mặc định ~/telegram-files).
# TELE_MEDIA_DIR=~/telegram-files
# File SQLite khi TELE_DATABASE_URL để trống.
# TELE_DB=~/.local/share/tele/messages.db
# Session Telegram — mỗi server có session riêng, tạo bằng `tele auth`.
# TELE_SESSION=~/.local/share/tele/telegram
# API credentials thay cho `tele configure` (phải khai báo cả hai).
# TELE_API_ID=
# TELE_API_HASH=
